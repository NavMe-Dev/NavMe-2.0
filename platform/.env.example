# Copy to .env and fill in. Never commit .env.
DOMAIN=maps.example.org                 # DNS A record -> your VM; Caddy gets HTTPS automatically
POSTGRES_DB=wayfinding
POSTGRES_USER=wayfinding
POSTGRES_PASSWORD=change-me-long-random
# Native (non-docker) runs use DATABASE_URL directly:
DATABASE_URL=postgresql+psycopg://wayfinding:change-me-long-random@localhost:5432/wayfinding
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=720
DATA_DIR=./var/data
MATTERPORT_SDK_KEY=                     # Showcase SDK application key (whitelist your domain in Matterport)
MATTERPORT_TOKEN_ID=                    # Model API token id (server-only) — enables "Fetch MatterPak from Matterport" in the Add building wizard
MATTERPORT_TOKEN_SECRET=                # Model API token secret (server-only, secret); needs the model's MatterPak add-on unlocked to return mesh
VPS_URL=                                # optional visual positioning service base URL (POST {VPS_URL}/localize)
PUBLIC_BASE_URL=https://maps.example.org
CORS_ORIGINS=*
GEOCODER=esri                           # esri | nominatim
# single-process dev mode: API serves viewer/admin and runs jobs in a thread
VIEWER_DIR=
ADMIN_DIR=
WORKER_INLINE=false
MAX_UPLOAD_MB=8192                      # MatterPak / E57 upload limit (prefer server path for multi-GB files)
WF_AR_VARIANT_LAUNCH_KEY=                 # Variant Launch SDK key (iOS App Clip WebXR); injected into /ar_webxr/config.js
# Public viewer chat (Option 3 phase 1). Same-origin POST /api/v1/public/chat; keys stay server-side.
WF_CHAT_ENABLED=true
# Free local default: start Ollama and run `ollama pull qwen2.5:3b`.
# OpenAI-compatible; hosted URLs also work. Ollama does not require a key.
WF_CHAT_LLM_BASE_URL=http://127.0.0.1:11434/v1
WF_CHAT_LLM_API_KEY=
WF_CHAT_LLM_MODEL=qwen2.5:3b
WF_CHAT_RATE_LIMIT_PER_MIN=20
