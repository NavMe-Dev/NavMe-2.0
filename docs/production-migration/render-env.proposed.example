# REVIEW PROPOSAL ONLY. No production setting has been applied.
# Obtain the exact secret from project kzpvhzyefdtrtidrbuxb's Connect panel.
# Keep the real URL in a secret manager / ignored local file, never in Git.
DATABASE_URL=<verified-direct-or-session-PostgreSQL-URL>
DB_SSLMODE=require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
RUN_MIGRATIONS=false
# Preserve existing DOMAIN, PUBLIC_BASE_URL, JWT_SECRET, DATA_DIR,
# VIEWER_DIR, ADMIN_DIR, WORKER_INLINE, SUPABASE_URL and Storage/Matterport keys.
# Prefer verify-full after the exact host and CA trust are validated.
# Validate statement timeout against long imports/publishing before release.
