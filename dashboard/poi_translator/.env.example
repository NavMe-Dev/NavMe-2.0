# Copy to `.env` in the poi_translator/ folder and fill in values.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL (same as VITE_SUPABASE_URL in the dashboard app).
SUPABASE_URL=https://znfwcohrpkiccibqcfpn.supabase.co

# API key used for inserts. Prefer the SERVICE ROLE key for a backend script so
# Row Level Security does not block inserts. If you only have the anon key and
# your RLS policy allows anon inserts, that also works.
SUPABASE_KEY=your-service-role-or-anon-key-here

# ── NavMe scoping ─────────────────────────────────────────────────────────────
# organization_id is required (NOT NULL) on navme_pois.
NAVME_ORGANIZATION_ID=db204331-02bd-4fa4-9c5d-569ea1d9329f

# poi_type scopes the POI to a project (used by the dashboard filters).
# Set the poi_type of the project you are adding POIs to.
NAVME_POI_TYPE=

# ── Translation ───────────────────────────────────────────────────────────────
# Backend: "google" (default, no API key) or "deepl" (needs DEEPL_API_KEY).
TRANSLATOR_BACKEND=google

# Language of the name you type in. "auto" lets the translator detect it.
SOURCE_LANGUAGE=auto

# Only required when TRANSLATOR_BACKEND=deepl
# DEEPL_API_KEY=
