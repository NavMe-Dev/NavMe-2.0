# Local dev: copy to `.env` next to package.json, then restart `npm run dev`.
# Production (Render): `.env.production` is committed — redeploy after changing keys.
# Supabase Dashboard → Project Settings → API:
#   Project URL  → VITE_SUPABASE_URL
#   anon public  → VITE_SUPABASE_ANON_KEY

# metadigilabs — NavMe Suhashouse project (znfwcohrpkiccibqcfpn)
VITE_SUPABASE_URL=https://znfwcohrpkiccibqcfpn.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Matterport Showcase Embed SDK key (Account Settings → Developer Tools).
# Vite inlines this at build time — set it on Render / in `.env.production` and redeploy.
# Allowlist the exact host (e.g. dashboard.navme.space + http/https) on that same key.
# VITE_MATTERPORT_SDK_KEY=your-matterport-sdk-key

# Matterport Cloud organization for Edit deep-links (Add Tag).
# Opens: https://my.matterport.com/models/{modelId}/edit?organization=…
# VITE_MATTERPORT_ORGANIZATION_ID=TiE3TUbvCc2

# Server-only Matterport Model API (pending tags). Never use VITE_ prefix.
# Local Vite middleware reads these from `.env`. Production: set the same names as
# Supabase Edge Function secrets (matterport-tags) or Render env if using Node.
# MATTERPORT_TOKEN_ID=
# MATTERPORT_TOKEN_SECRET=
# Optional — white-labeled partner POI API (default: https://api.navme.space).
# Must reverse-proxy to: https://znfwcohrpkiccibqcfpn.supabase.co/functions/v1/partner-pois
# VITE_PARTNER_API_BASE=https://api.navme.space

# MultiSet browser proxy (recommended for production — avoids Multiset CORS allowlists).
# VITE_MULTISET_PROXY_URL=https://znfwcohrpkiccibqcfpn.supabase.co/functions/v1/multiset-proxy

# Optional — call api.multiset.ai directly (requires your site origin in Multiset CORS settings).
# VITE_MULTISET_API_ORIGIN=https://api.multiset.ai

# Optional — shared organization id for all projects (default: Suhas House).
# VITE_DEFAULT_ORGANIZATION_ID=db204331-02bd-4fa4-9c5d-569ea1d9329f

# Default (unset): prefer TexturedMesh.glb for full-color maps on sign-in.
# Set VITE_PREFER_TEXTURED_MESH=false to default API mesh selection to lighter Mesh.glb (dev/debug).
# VITE_PREFER_TEXTURED_MESH=false

# Optional — raises MyMemory free Save-translate quota (~50k chars/day).
# VITE_MYMEMORY_EMAIL=you@company.com
