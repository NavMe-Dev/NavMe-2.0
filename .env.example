# Copy to .env and fill in real values. Never commit .env.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Matterport ────────────────────────────────────────────────────────────────
MATTERPORT_SDK_KEY=
MATTERPORT_TOKEN_ID=
MATTERPORT_TOKEN_SECRET=
VITE_MATTERPORT_SDK_KEY=

# ── Platform API ───────────────────────────────────────────────────────────────
DOMAIN=localhost
POSTGRES_DB=wayfinding
POSTGRES_USER=wayfinding
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql+psycopg://wayfinding:change-me-long-random@localhost:5544/wayfinding
JWT_SECRET=generate-with-openssl-rand-hex-32
JWT_EXPIRE_MINUTES=720
DATA_DIR=./var/data
PUBLIC_BASE_URL=http://127.0.0.1:8780
CORS_ORIGINS=*
GEOCODER=esri
VIEWER_DIR=viewer
ADMIN_DIR=admin
WORKER_INLINE=true
MAX_UPLOAD_MB=8192

# ── Dashboard → Platform API ───────────────────────────────────────────────────
VITE_PARTNER_API_BASE=http://127.0.0.1:8780
VITE_MULTISET_PROXY_URL=https://your-project.supabase.co/functions/v1/multiset-proxy
VITE_NAVME_STANDALONE=true

# ── AR / Chat (optional) ───────────────────────────────────────────────────────
WF_AR_VARIANT_LAUNCH_KEY=
WF_CHAT_ENABLED=false
WF_CHAT_LLM_BASE_URL=http://127.0.0.1:11434/v1
WF_CHAT_LLM_API_KEY=
WF_CHAT_LLM_MODEL=qwen2.5:3b
WF_CHAT_RATE_LIMIT_PER_MIN=20
VPS_URL=
